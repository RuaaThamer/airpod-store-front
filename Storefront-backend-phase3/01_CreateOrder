/**
 * API Endpoint: /api/CreateOrder
 * Purpose: Receive user orders, save to SQL, and push to Service Bus Queue.
 * This ensures the frontend gets an immediate response while processing happens in the background.
 */

const sql = require('mssql');
const { ServiceBusClient } = require("@azure/service-bus");

module.exports = async function (context, req) {
    context.log('Starting order creation process...');

    const sqlConnStr = process.env.SqlConnectionString;
    const sbConnStr = process.env.ServiceBusConnection;
    const queueName = "orders-queue";

    try {
        const { productId, customerName, price } = req.body;

        // 1. Data Validation
        if (!productId || !customerName) {
            context.res = { status: 400, body: "Missing required order information." };
            return;
        }

        // 2. Database Operation: Save the order with a 'Pending' status
        await sql.connect(sqlConnStr);
        const dbResult = await sql.query(`
            INSERT INTO Orders (ProductID, CustomerName, TotalPrice, OrderStatus)
            OUTPUT INSERTED.OrderID
            VALUES (${productId}, '${customerName}', ${price}, 'Pending')
        `);
        
        const newOrderId = dbResult.recordset[0].OrderID;
        context.log(`Success: Order saved to database with ID: ${newOrderId}`);

        // 3. Service Bus Operation: Send a message to the queue for async processing
        const sbClient = new ServiceBusClient(sbConnStr);
        const sender = sbClient.createSender(queueName);
        
        const messageBody = {
            orderId: newOrderId,
            productId: productId,
            customerName: customerName,
            timestamp: new Date().toISOString()
        };

        await sender.sendMessages({ body: messageBody });
        await sbClient.close();
        context.log('Success: Message sent to Service Bus queue.');

        // 4. Return success response to the client immediately
        context.res = {
            status: 201,
            body: { 
                success: true, 
                message: "Order received! Our system is processing it in the background.",
                orderId: newOrderId 
            }
        };

    } catch (err) {
        context.log.error("Error in CreateOrder:", err.message);
        context.res = { status: 500, body: "System Error: " + err.message };
    }
};